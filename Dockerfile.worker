# syntax=docker/dockerfile:1
# Só o worker (pg-boss: sincronização de turmas e de colaboradores do IAM Control), para o EasyPanel, que constrói o
# último estágio do arquivo: no serviço do worker, Construção › Dockerfile › Arquivo = Dockerfile.worker.
# Igual ao target `worker` do Dockerfile principal.

FROM node:22-alpine AS worker-deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev

FROM node:22-alpine AS worker
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
COPY --from=worker-deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
USER worker
CMD ["node", "--import", "tsx", "src/worker.ts"]

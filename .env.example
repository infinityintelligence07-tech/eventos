# Supabase iam-pessoas (sa-east-1). Dashboard > Connect > Session pooler (porta 5432).
# Local: Postgres com as migrations do GH-System aplicadas antes das do Eventos.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iam
# Opcional: conexão direta para o worker (pg-boss usa LISTEN e sessões longas).
WORKER_DATABASE_URL=
# IAM Control (sincronização de turmas). Token: EVENTOS_WEBHOOK_TOKENS do lado do IAM Control.
IAM_CONTROL_URL=https://iamcontrol.com.br
IAM_CONTROL_EVENTOS_TOKEN=
LOG_LEVEL=info
# Login (Supabase Auth do iam-pessoas, só Google). Opcionais fora de produção (o dev:local usa "Entrar como");
# obrigatórias em produção. Só a chave pública (anon/publishable): o Eventos não usa service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do Eventos (ex.: https://eventos.dominio). Monta o retorno do Google e o destino do callback.
EVENTOS_URL_PUBLICA=

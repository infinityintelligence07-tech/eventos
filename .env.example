# Supabase iam-pessoas (sa-east-1). Dashboard > Connect > Session pooler (porta 5432).
# Local: Postgres com as migrations do GH-System aplicadas antes das do Eventos.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iam
# Opcional: conexão direta para o worker (pg-boss usa LISTEN e sessões longas).
# Sincronização de turmas e worker: papel app_eventos_worker (migration 0009). Vazio = usa a DATABASE_URL.
# postgresql://app_eventos_worker.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
WORKER_DATABASE_URL=
# IAM Control (sincronização de turmas). Token: EVENTOS_WEBHOOK_TOKENS do lado do IAM Control.
IAM_CONTROL_URL=https://iamcontrol.com.br
IAM_CONTROL_EVENTOS_TOKEN=
LOG_LEVEL=info
# Login (Supabase Auth do iam-pessoas, só Google). Opcionais fora de produção (o dev:local usa "Entrar como");
# obrigatórias em produção. Só a chave pública (anon/publishable): o Eventos não usa service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do Eventos (ex.: https://eventos.dominio). Monta o retorno do Google e o destino do callback.
EVENTOS_URL_PUBLICA=
# Comprovantes do formulário de custo do staff (docs/08 §11.4). Só no servidor web. Storage do Supabase pelo protocolo
# S3, com uma chave de acesso S3 (Storage > S3 Connection > Access keys), que só alcança o Storage. Nunca a
# service_role. Sem as cinco, o anexo fica desligado e o formulário funciona sem o campo. Conferir: npm run comprovantes:testar
# Endpoint S3 do projeto, sem o bucket (https://<projeto>.storage.supabase.co/storage/v1/s3).
COMPROVANTES_S3_ENDPOINT=
# Região do projeto (a do iam-pessoas é sa-east-1). Entra na assinatura das requisições.
COMPROVANTES_S3_REGIAO=
# Bucket PRIVADO criado para isso (eventos-comprovantes).
COMPROVANTES_S3_BUCKET=
# Id e segredo da chave de acesso S3. O segredo só aparece uma vez, na criação.
COMPROVANTES_S3_CHAVE_ID=
COMPROVANTES_S3_CHAVE_SEGREDO=

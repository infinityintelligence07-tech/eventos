{
  "name": "eventos",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:local": "node --import tsx scripts/dev-local.ts",
    "banco:local": "node --env-file-if-exists=.env --import tsx scripts/banco-local/index.ts",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "sync:turmas": "node --env-file-if-exists=.env --import tsx src/jobs/cli-sincronizar-turmas.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "pg": "^8.23.0",
    "pg-boss": "^12.38.0",
    "pg-connection-string": "^2.14.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  }
}
